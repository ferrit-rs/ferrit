# Project API key for capturing events, safe to expose client-side (capture-only).
# PostHog -> project -> Settings -> Project -> "Project API Key"
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Personal API key for querying PostHog data (HogQL API), not used by the app itself.
# PostHog -> Settings -> search "personal api" -> Create -> scope: read on "Query"
POSTHOG_PERSONAL_API_KEY=phx_xxx

# Vercel project link, used by deploy.sh. Not a secret, just avoids `vercel link` prompts.
# `vercel project ls` / `.vercel/project.json` (after `vercel link`) to find these.
VERCEL_ORG_ID=team_xxx
VERCEL_PROJECT_ID=prj_xxx
