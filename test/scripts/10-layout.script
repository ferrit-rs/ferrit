# Phase 1, layout: five left panes, one right pane, focus keys, selection
# clamping, resizing and the help overlay. The focused pane is the one a
# movement key changes, so each check moves a cursor and reads its counter.
fixture canonical
size 120x40

expect-text "[1] Status"
expect-text "[2] Files"
expect-text "[3] Local branches"
expect-text "[4] Commits"
expect-text "[5] Stash"
expect-text "Infos"                        # the command log heading

# Number keys focus a pane; j / k move within it and stop at the ends.
key 2
expect-text "1 of 6"
key j j
expect-text "3 of 6"
key j j j j j j j j
expect-text "6 of 6"                       # clamped at the last row
key k k k k k k k k k k
expect-text "1 of 6"                       # and at the first

key 3 j
expect-text "2 of 3"                       # Branches moved, Files did not
key 4 j j
expect-text "3 of 4"
key 2
expect-text "1 of 6"

# Tab and Shift-Tab walk the panes in order. Each pane keeps its own cursor:
# Files is at 1 of 6, Branches at 2 of 3, Commits at 3 of 4.
key 1
key tab tab j
expect-text "3 of 3"                       # Status -> Files -> Branches, moved
key backtab j
expect-text "2 of 6"                       # back on Files, moved
key right right j
expect-text "4 of 4"                       # Files -> Branches -> Commits, moved

# Any size draws; nothing panics or loses the layout.
resize 40x20
expect-text "[1] Status"
resize 200x60
expect-text "[5] Stash"
resize 80x24
expect-text "[2] Files"
snapshot small

# The help overlay toggles.
resize 120x40
expect-no-text "toggle this help"
key ?
expect-text "toggle this help"
expect-text "keybindings"
key ?
expect-no-text "toggle this help"
