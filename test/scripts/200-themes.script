# Phase 18, themes: the Theme row of the settings sheet picks Terminal, Dark or
# Light, either arrow or a click, and a new start finds the choice. (The colours
# themselves are checked on the cells in tests/scheme_paint.rs; a replay frame is
# text.)
fixture canonical
size 120x50
config-file ""

click-text "Ferrit Fixture"
expect-text "(•) Dark"
expect-no-text "Terminal is"          # no brightness row: Terminal is just Terminal

key right
expect-text "(•) Light"
key right
expect-text "(•) Terminal"
key left
key left
expect-text "(•) Dark"
click-text "( ) Terminal"
expect-text "(•) Terminal"
click-text "( ) Light"
expect-text "(•) Light"

# Close and start again: it is still Light.
key esc
reopen
click-text "Ferrit Fixture"
expect-text "(•) Light"
snapshot light
