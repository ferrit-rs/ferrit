# Phase 18, painted themes: the Theme row of the settings sheet picks Dark or
# Light, either arrow or a click, and a new start finds the choice. (The colours
# themselves are checked on the cells in tests/scheme_paint.rs; a replay frame is
# text.)
fixture canonical
size 120x50
config-file ""

click-text "Ferrit Fixture"
expect-text "(•) Dark"
expect-no-text "Terminal"

key right
expect-text "(•) Light"
key left
expect-text "(•) Dark"
click-text "( ) Light"
expect-text "(•) Light"

# Close and start again: it is still Light.
key esc
reopen
click-text "Ferrit Fixture"
expect-text "(•) Light"
snapshot light
