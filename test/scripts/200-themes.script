# Phase 18, painted themes: the Theme row of the settings sheet picks Terminal, Dark
# or Light, either arrow or a click, and a new start finds the choice. "Terminal is"
# shows under Terminal only. (The colours themselves are checked on the cells in
# tests/scheme_paint.rs; a replay frame is text.)
fixture canonical
size 120x50
config-file ""

click-text "Ferrit Fixture"
expect-text "(•) Dark"
expect-no-text "Terminal is"

key right
expect-text "(•) Light"
key right
expect-text "(•) Terminal"
expect-text "Terminal is"
key left
key left
expect-text "(•) Dark"
click-text "( ) Terminal"
expect-text "(•) Terminal"
expect-text "Terminal is"
click-text "( ) Light"
expect-text "(•) Light"
expect-no-text "Terminal is"

# Close and start again: it is still Light.
key esc
reopen
click-text "Ferrit Fixture"
expect-text "(•) Light"
snapshot light
