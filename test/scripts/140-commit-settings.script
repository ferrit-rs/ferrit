# Phase 12 P6, commit settings: commit.template pre-fills a new commit, minus
# its comments, and the summary shows an n/50 length counter.
fixture canonical
size 200x50

git config commit.template tpl.txt => ""
write tpl.txt "feat: \n\nWhy:\n# a comment\n"
key 2 j j j space                          # stage docs/notes.md
key c
expect-text "feat: "
expect-text "Why:"
expect-no-text "a comment"
expect-text " 6/50 "                        # "feat: " is 6 characters
type "a subject that is far longer than fifty characters, still fine"
expect-text "/50 "
key esc
