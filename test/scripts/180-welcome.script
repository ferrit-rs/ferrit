# Phase 16, start outside a repository: in a folder that is not one, ferrit opens
# a welcome screen instead of exiting. `i` asks, naming the folder, and creates
# nothing until the yes; then the panes open on an empty repository, and the
# phase-15 action that publishes it is there.
fixture norepo
size 120x40

expect-text "is not a git repository."
expect-text "Initialise a repository here (git init)"
expect-text "q   Quit"
expect-text "Choose: enter | Init: i | Quit: q"
expect-no-text "[2] Files"                # no pane is drawn
snapshot welcome

# The arrows move the highlight and Enter runs the highlighted row; the letters
# i and q still work from anywhere. Nothing else does anything: no pane action
# can run without a repository.
expect-text "▸ i   Initialise"
key down
expect-text "▸ q   Quit"
snapshot highlight
key up
expect-text "▸ i   Initialise"
key x D C c f p P 1 ? @
expect-text "is not a git repository."
expect-no-text "Dashboard"

# The question names the folder; no creates nothing.
key i
expect-text "run git init in"
expect-text "norepo?"
snapshot question
key n
expect-text "is not a git repository."
git rev-parse --git-dir -> "not a git repository"

# Esc at the question is an answer, not a quit.
key i
key esc
expect-text "is not a git repository."
git rev-parse --git-dir -> "not a git repository"

# The yes, keyboard only: Enter on the highlighted row asks, Enter answers.
key enter
expect-text "run git init in"
key enter
expect-no-text "is not a git repository."
expect-text "[2] Files"
expect-text "[4] Commits"
git rev-parse --is-inside-work-tree => "true"
git rev-list --all --count => "0"
snapshot initialised

# It is a repository like any other. With no commit and no remote, G publishes it
# in one go: the first commit (an empty README.md), the repository, the push.
exec config user.name "Ferrit Fixture"
exec config user.email "fixture@example.com"
key G
expect-text "Create on GitHub"
expect-text "Initial commit with an empty README.md"
key enter
expect-text "first: commit an empty README.md"
async-key y
git log --format=%s => "Initial commit"
git ls-tree -r --name-only HEAD => "README.md"
git cat-file -s HEAD:README.md => "0"
git remote => "origin"
git config --get remote.origin.url => "git@replay-alias:fake-user/norepo.git"
git ls-remote origin -> "refs/heads/"
snapshot published

# With a remote the action is gone.
key G
expect-text "already has a remote"
