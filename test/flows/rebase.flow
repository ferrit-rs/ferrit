# Rewriting history from the Commits panel (docs/PLAN_11_REBASE.md): reword,
# squash, drop. Same keys in both programs; the git state must match.
# Run on a copy: .dev-tools/flow-compare.sh --repo . test/flows/rebase.flow
repo .
focus "rewriting local commits from the Commits panel: reword, squash, drop: the git result (messages, commit count, worktree), the confirmations asked, and the selection afterwards"
not "how the panels are sized, launch screen, mouse and scrolling (ui-mouse); fixup and autosquash keys, which differ on purpose; an operation stopped by a conflict"

sh "git reset -q --hard && git clean -fdq && git checkout -q main"
sh "git checkout -q -b flow-rewrite && for n in 1 2 3; do echo \$n > FLOW_\$n.txt; git add FLOW_\$n.txt; git commit -qm \"flow: commit \$n\"; done"
note "Three local commits on top of the history: 'flow: commit 3' on top."

step 01_start
step 02_focus_commits 4
note "r on the top commit: a popup with its message; add a word and confirm."
step 03_reword_prompt r
step 04_reword_typed "text: (reworded)" Enter
note "Second commit, then s: it is squashed into the one below."
step 05_select_second j
step 06_squash_prompt s
step 07_squash_confirm Enter Escape
note "Top commit, then d: a confirm, then y."
step 08_select_top k
step 09_drop_prompt d
step 10_drop_confirm y Enter Escape
